<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/p5Bg"
    android:orientation="vertical">

    <!-- כותרת קבועה עם הסטטוס -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/p5Header"
        android:orientation="vertical"
        android:paddingBottom="10dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/header_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- הכפתור הראשי: מקבל את הפוקוס ההתחלתי -->
            <Button
                android:id="@+id/btnToggle"
                style="@style/ActionButton"
                android:layout_height="60dp"
                android:layout_marginTop="0dp"
                android:text="@string/btn_start"
                android:textSize="20sp"
                android:textStyle="bold">
                <requestFocus />
            </Button>

            <!-- כרטיס: מה מקיש 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/p5Card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/taps_title" />

                <RadioGroup
                    android:id="@+id/rgTaps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbTapsOne"
                        style="@style/OptionRow"
                        android:text="@string/taps_one" />

                    <RadioButton
                        android:id="@+id/rbTapsTwo"
                        style="@style/OptionRow"
                        android:text="@string/taps_two" />
                </RadioGroup>
            </LinearLayout>

            <!-- כרטיס: שיטת ההקשה -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/p5Card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/method_title" />

                <RadioGroup
                    android:id="@+id/rgMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbAuto"
                        style="@style/OptionRow"
                        android:text="@string/method_auto" />

                    <RadioButton
                        android:id="@+id/rbRoot"
                        style="@style/OptionRow"
                        android:text="@string/method_root" />

                    <RadioButton
                        android:id="@+id/rbAccessibility"
                        style="@style/OptionRow"
                        android:text="@string/method_accessibility" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnAccessibility"
                    style="@style/SecondaryButton"
                    android:text="@string/btn_accessibility" />

                <Button
                    android:id="@+id/btnRequestRoot"
                    style="@style/SecondaryButton"
                    android:text="@string/btn_request_root" />
            </LinearLayout>

            <!-- כרטיס: אפשרויות -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/p5Card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/options_title" />

                <CheckBox
                    android:id="@+id/cbHideNotif"
                    style="@style/OptionRow"
                    android:text="@string/hide_notification" />

            </LinearLayout>

            <!-- כרטיס: אבחון ויומן -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/p5Card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/log_title" />

                <Button
                    android:id="@+id/btnTestSend"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="0dp"
                    android:text="@string/btn_test_send" />

                <Button
                    android:id="@+id/btnDiagHeadset"
                    style="@style/SecondaryButton"
                    android:text="@string/btn_diag_headset" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRefreshLog"
                        style="@style/ActionButton"
                        android:layout_width="0dp"
                        android:layout_marginRight="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_refresh_log" />

                    <Button
                        android:id="@+id/btnClearLog"
                        style="@style/SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_marginLeft="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_clear_log" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/p5TextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
