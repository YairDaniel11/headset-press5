<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- בלי AndroidX: ערכת נושא גולמית עם attrs מופשטים (כמו ב-ZIM וב-"שליחה קלה") -->
    <style name="AppTheme" parent="android:Theme.Holo.NoActionBar">
        <item name="p5Bg">@color/bg_night</item>
        <item name="p5Header">@color/header_night</item>
        <item name="p5Accent">@color/accent_blue_light</item>
        <item name="p5Text">@color/text_night</item>
        <item name="p5TextSecondary">@color/text_night_secondary</item>
        <item name="p5Card">@drawable/card_night</item>
        <item name="android:windowBackground">@color/bg_night</item>
    </style>

    <style name="AppTheme.Dark" parent="AppTheme" />

    <style name="AppTheme.Light" parent="android:Theme.Holo.Light.NoActionBar">
        <item name="p5Bg">@color/bg_light</item>
        <item name="p5Header">@color/header_light</item>
        <item name="p5Accent">@color/accent_blue</item>
        <item name="p5Text">@color/text_dark</item>
        <item name="p5TextSecondary">@color/text_dark_secondary</item>
        <item name="p5Card">@drawable/card_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
    </style>

    <style name="ActionButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/btn_primary</item>
    </style>

    <style name="SecondaryButton" parent="ActionButton">
        <item name="android:background">@drawable/btn_secondary</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/p5Accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="OptionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textColor">?attr/p5Text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/option_selector</item>
    </style>
</resources>
